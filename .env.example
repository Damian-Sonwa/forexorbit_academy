# --- MongoDB (required) ---
# Use the same Atlas (or local) connection string everywhere. Either name works:
MONGO_URI=
# MONGODB_URI=
# Default DB name used by the app: Forex_elearning (often included in the URI path)
# Local or test work: set an isolated database name. Payment routes refuse to run outside
# production unless this differs from Forex_elearning or MONGO_URI points at localhost.
# MONGODB_DB_NAME=forexorbit_local

# --- Password reset by email (Resend) — lib/email.ts ---
# Reset links are built only from APP_BASE_URL, never from request headers.
# Production (NODE_ENV=production) refuses to send unless all three are set: APP_BASE_URL must be an
# https origin with no path, and RESEND_FROM must be an address on a domain verified in Resend
# (the @resend.dev test sender is refused). Without them, forgot-password still answers normally
# but sends nothing, and no reset link is created.
# Development: without RESEND_API_KEY nothing is sent. With a key, RESEND_FROM defaults to Resend's
# test sender (delivers only to the Resend account owner) and APP_BASE_URL to http://localhost:3000.
# APP_BASE_URL=https://your-app.example.com
# RESEND_API_KEY=
# RESEND_FROM="ForexOrbit Academy <no-reply@your-verified-domain.example>"

# --- Sessions and origin (server only): one canonical HTTPS origin ---
# One server (node server.js) serves the pages, the API and Socket.IO on this origin. The browser
# always calls the API and the socket with relative URLs, so no variable points it elsewhere.
# Required in production: the server refuses to start without it, and every state-changing API
# request must come from it. No path, no trailing slash. Production:
# APP_ORIGIN=https://forexorbit-academy.onrender.com
# Signs and verifies pre-4.5 tokens; still required to start. Keep it unchanged; never reuse it on staging.
JWT_SECRET=
# TEMPORARY, disabled by decision: until this ISO date (at most 2027-01-31) a browser holding a
# pre-4.5 token may exchange it once for a cookie session. Leave unset.
# AUTH_LEGACY_BEARER_UNTIL=
# No longer read; remove them where they are still set: NEXT_PUBLIC_API_BASE_URL,
# NEXT_PUBLIC_API_URL, NEXT_PUBLIC_SOCKET_URL, ALLOWED_ORIGINS, NEXT_PUBLIC_APP_URL.

# --- Platform (server only) ---
# Node.js version on Render (the validated runtime).
# NODE_VERSION=22.19.0
# Proxies in front of the server that append to X-Forwarded-For (default 1).
# TRUSTED_PROXY_HOPS=1
# "mongodb" shares login and reset rate limits across instances (needs its index; see docs/audits).
# SHARED_RATE_LIMIT=mongodb
# "delete" removes replaced uploads from Cloudinary; unset only reports them.
# MEDIA_CLEANUP=

# --- Paystack (one-time full-course purchase) ---
# The course price (₦10,000 NGN) is set in code: lib/course-price.js. No price or currency
# variable overrides it; PAYSTACK_COURSE_PRICE_KOBO, NEXT_PUBLIC_PAYSTACK_COURSE_PRICE_KOBO,
# PAYSTACK_LESSON_PRICE_KOBO, and PAYSTACK_CURRENCY are no longer read.
# Outside production, only sk_test_ keys are accepted, together with an isolated database.
# Production (NODE_ENV=production, which npm start always sets) accepts only sk_live_ keys.
# Secret key: server only.
# PAYSTACK_SECRET_KEY=
# Public key (pk_live_... with a live secret key): read by the browser checkout and compiled in
# by "next build", so it must be set before the build. A missing or malformed key disables checkout.
# NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
# Webhook URL in Paystack Dashboard: https://YOUR_DOMAIN/api/paystack/webhook
# Every webhook must carry a valid x-paystack-signature; unsigned requests are rejected.

# --- Ads: PropellerAds on free first lesson + demo tasks only (paid lessons: no ads) ---
# NEXT_PUBLIC_ADS_ENABLED=true
# propellerads | adsense | admob | none
# NEXT_PUBLIC_ADS_PROVIDER=propellerads
#
# Option A — one widget script (Propeller “Get code” URL). Used for top banner if set:
# NEXT_PUBLIC_PROPELLERADS_WIDGET_SCRIPT_URL=https://...
#
# Option B — shared library + zone id (ins[data-zoneid]):
# NEXT_PUBLIC_PROPELLERADS_LIBRARY_SCRIPT_URL=https://...
# NEXT_PUBLIC_PROPELLERADS_ZONE_ID=your_zone_id
# Optional class on <ins> from Propeller:
# NEXT_PUBLIC_PROP_PLACEMENT_LESSON_TOP_INS_CLASS=
#
# Per-surface overrides (see lib/propeller-ads-placements.ts):
# NEXT_PUBLIC_PROP_PLACEMENT_LESSON_TOP_SCRIPT=
# NEXT_PUBLIC_PROP_PLACEMENT_LESSON_INLINE_SCRIPT=
# NEXT_PUBLIC_PROP_PLACEMENT_DEMO_TASKS_SCRIPT=
# NEXT_PUBLIC_PROP_PLACEMENT_INTERSTITIAL_SCRIPT=
# (or _LIB / _ZONE / _INS_CLASS variants for each placement)
#
# Legacy Google:
# NEXT_PUBLIC_ADSENSE_CLIENT=
# NEXT_PUBLIC_ADSENSE_BANNER_SLOT=
# NEXT_PUBLIC_ADMOB_WEB_BANNER_SLOT=

# --- Uploads, calls, AI and broker demo (server only) ---
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
# AGORA_APP_ID=
# AGORA_APP_CERTIFICATE=
# NEXT_PUBLIC_AGORA_APP_ID is accepted as an older name for AGORA_APP_ID (read on the server only).
# AI_API_KEY=
# AI_MODEL=
# AI_MAX_TOKENS=
# AI_TEMPERATURE=
# OANDA_API_KEY=
# OANDA_ACCOUNT_ID=
# OANDA_DEMO_URL=
# BROKER_TYPE=
# BROKER_DEMO_MODE=

# --- Other browser settings (public values, compiled in at build time) ---
# NEXT_PUBLIC_BROKER_API_ENABLED=false
# NEXT_PUBLIC_PHONE_DEFAULT_REGION=NG
# SMS_DEFAULT_REGION=NG

# Required only for npm run seed. The seed script exits before any write when this is missing or shorter than 12 characters.
# Use a new demo password. Do not reuse a production password.
DEMO_SEED_PASSWORD=
